# Anthropic API key (server-only). REQUIRED for quest generation —
# /api/generate and /api/generate/stream return 503 without it and there is
# no local fallback generator.
ANTHROPIC_API_KEY=

# Model routing (all optional — see lib/model-routing.ts).
# First roll of a session + Pro users route to MODEL_FIRST_ROLL; rerolls use
# MODEL_REROLL. MODEL_FORCE_HAIKU=1 is the kill switch: forces
# claude-haiku-4-5 everywhere, ignoring the other two.
#MODEL_FIRST_ROLL=claude-sonnet-4-6
#MODEL_REROLL=claude-haiku-4-5
#MODEL_FORCE_HAIKU=

# Supabase (auth + storage + database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Mapbox GL JS access token. Required for /map and lazy geocoding.
# If unset, /map renders the "Map is offline" empty state and geocoding no-ops.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Admin console (server-only — do NOT prefix with NEXT_PUBLIC_).
# Password for /admin login. Required for the admin console to work.
ADMIN_PASSWORD=set-in-vercel-dashboard
# Random 32+ byte secret used to HMAC-sign the sq_admin session cookie.
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=set-in-vercel-dashboard
